# Virtual environment
venv/

# Inference outputs
runs/

# Labeling working data (extracted frames, exported datasets).
# Ignore everything under data/ EXCEPT the dashboard's mock results.json.
# (Ignore data/* rather than data/ so git can descend and re-include the file.)
data/*
!data/results.json

# Sample video data (large / not source)
videos/

# Python
__pycache__/
*.pyc

# OS junk
.DS_Store

# Editors
.vscode/
.idea/

# Claude Code local files
.claude/

# Secrets
.env

# Large media & dataset archives (safety net beyond videos/ and data/).
# Model weights (*.pt) are intentionally committed, so they are NOT ignored.
*.mp4
*.mov
*.avi
*.zip
